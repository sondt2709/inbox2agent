{
  "manifestVersion": 1,
  "id": "i2a",
  "publisher": "inbox2agent",
  "name": "i2a notifications",
  "version": "1.0.0",
  "description": "Shows the notifications of i2a (inbox2agent) in Orca and on the phones that are paired with Orca.",
  "repository": "https://github.com/sondt2709/inbox2agent",
  "icon": "icon.png",
  "engines": { "orca": ">=1.4.0" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "commands": [{ "id": "notify", "title": "i2a: Show a notification" }]
  },
  "capabilities": [{ "kind": "notifications:show" }]
}
